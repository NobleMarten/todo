# Контекст сборки бэкенда: всё, что не нужно компилятору Go.
# Чем меньше контекст — тем быстрее сборка и тем меньше шансов
# случайно запечь секрет в слой образа.

.git
.gitignore
.DS_Store
**/.DS_Store

# секреты и локальное состояние — в образ не попадают никогда
.env
.envlocal
.env.example

# фронтенд собирается своим Dockerfile'ом (и тащит node_modules)
frontend/

# артефакты, мёртвый код, файловое хранилище CLI
old_cod/
data/
api-test/

# доки и конфиги агентов
*.md
.claude/

# сами докер-файлы внутри образа тоже не нужны
Dockerfile
compose.yml
.dockerignore
db/
