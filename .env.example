# Скопировать в .env и поправить значения.
#
# Файл читают ДВА потребителя:
#   1. приложение, запущенное на хосте (godotenv в internal/config);
#   2. docker compose — он автоматически подхватывает ./.env
#      для подстановки ${...} в compose.yml.

# ── приложение при запуске на хосте (go run ./cmd/todo-api) ──────────────────
ENV=local
PORT=8080
HTTP_SHUTDOWN_TIMEOUT=10s

# Используется ТОЛЬКО при запуске на хосте. Внутри compose адрес БД
# собирается из POSTGRES_* ниже и указывает на сервис db, а не на localhost.
DB_URL=postgres://todo_user:password@localhost:5432/todo_db?sslmode=disable

# ── docker compose ───────────────────────────────────────────────────────────
POSTGRES_USER=todo_user
# на проде обязательно заменить
POSTGRES_PASSWORD=password
POSTGRES_DB=todo_db

# Порты, которые compose публикует на хост.
# FRONTEND_PORT не 80, чтобы не конфликтовать с nginx, уже стоящим на VPS.
# На что биндить опубликованные порты. 127.0.0.1 = только локально,
# наружу — через nginx. Менять на 0.0.0.0 только осознанно.
BIND_IP=127.0.0.1

API_PORT=8080
FRONTEND_PORT=8081
DB_PORT=5432

# Пусто = фронт шлёт относительные /todos, nginx из контейнера frontend
# проксирует их на backend. Заполнять, только если API живёт по другому адресу.
VITE_API_URL=
